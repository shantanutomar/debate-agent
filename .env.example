# ── Backend (api/.env.local) ─────────────────────────────────────────────────

# Optional: fallback OpenAI key used when the user doesn't enter one in the UI.
OPENAI_API_KEY=sk-...

# Comma-separated list of allowed frontend origins for CORS.
# Development default: http://localhost:5173 (set automatically if this is blank).
# Production: set this in the Railway dashboard to your Vercel URL.
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Frontend (web/.env.local) ────────────────────────────────────────────────

# URL of the Railway backend. Falls back to http://localhost:8000 in dev.
# Set this in the Vercel dashboard → Project → Environment Variables.
VITE_API_URL=https://your-app.up.railway.app
